<?xml version="1.0" encoding="iso-8859-1"?>
<root>
  <array id="COMPONENTS">

    <node
     name="fader"
     type="RECTANGLE"
     inherit="EditorFaderRectangle"
     on_click_script_call="UI_PopScreen();"
