     button.ninepatch_width="105"
     button.ninepatch_height="30"
    />

    <node
     name="SaveAndExit"
     type="BUTTON"
     inherit="EditorSmallButton"
     parent="aligner_syntax_NONE"
     button.text="Save and Exit"
     button.ninepatch_width="110"
     button.ninepatch_height="30"
