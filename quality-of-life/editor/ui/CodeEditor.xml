     name="AutoCompile"
     type="CHECKBOX"
     inherit="EditorCheckbox"
     parent="aligner_syntax_SQUIRREL"
     tooltip_text="Automatically compiles and shows errors if not pressed any key for a while."
     checkbox.value="1"
     checkbox.text="Autocompile"
     checkbox.toggle_value_on_click="true"
    />

    <node
     name="Documentation"
     type="BUTTON"
     inherit="EditorSmallButton"
     parent="aligner_syntax_SQUIRREL"
     tooltip_text="Shows list of constants and functions (Use CTRL+SPACE for autocomplete)"
     button.text="API Docs"
     button.ninepatch_width="65"
     button.ninepatch_height="30"
    />

