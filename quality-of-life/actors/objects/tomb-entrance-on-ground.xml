    <node
      interaction_0_id="descend"
        interaction_0_script_to_test_if_interaction_is_available="function IsInteractionAvailable(so_self, so_activator)&#10;{&#10;&#9;return StageObject_GetKeyValue(so_self, &#34;unlocked&#34;) &#38;&#38;&#10;&#9;&#9;   !Game_IsShowingActorNotification(so_activator);&#10;}"
        interaction_0_script_to_run_on_interaction="function OnInteraction(so_self, so_activator)&#10;{&#10;&#9;if (Game_IsRecipeCrafted(&#34;ROPE_AND_HOOK&#34;))&#10;&#9;{&#10;&#9;&#9;// This is added here to make old saves work properly. Can be removed later.&#10;&#9;&#9;Game_SetWorldState(&#34;TOMBS&#34;, &#34;activated&#34;, &#34;1&#34;);&#10;&#10;&#9;&#9;Actor_QueueActionWaitForCommandWord(so_self, &#34;wait&#34;);&#10;&#9;&#9;Actor_QueueActionMoveToDistanceFromActor(so_activator, so_self, 25);&#10;&#9;&#9;Actor_QueueActionSendCommandWord(so_activator, so_self, &#34;wait&#34;);&#10;&#9;&#9;Actor_QueueActionPlayAnimation(so_activator, &#34;tool_unequip&#34;, true);&#10;&#9;&#9;Actor_QueueActionPlayAnimation(so_activator, &#34;enter_tomb_outside&#34;, false);&#10;&#9;&#9;Game_SetCinemaMode(true);&#10;&#9;&#9;Game_SetScreenFadeOutWithCommand(3, &#34;travel_to_stage&#34;, so_self, 3.0);&#10;&#9;}&#10;&#9;else&#10;&#9;{&#10;&#9;&#9;Game_AddActorNotification(so_activator, LOC_TEXT(&#34;That looks deep. I need to invent and craft a [GREEN]Rope and Hook[WHITE] to climb down there! [EMOJI=thinking face].&#34;));&#10;&#9;&#9;Game_SetRecipeUnlocked(&#34;ROPE_AND_HOOK&#34;, true, true);&#10;&#9;&#9;Actor_SetInteractionEnabled(so_self, &#34;descend&#34;, true);&#10;&#9;}&#10;}"
