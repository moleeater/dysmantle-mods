	<array id="SCRIPTS">
		<node id="embedded_ai_script" ><![CDATA[

function OnThink(so_actor, tdelta)
{
  local flying = StageObject_GetKeyValue(so_actor, "flying");
  if (flying == null)
    return;
  if (!flying)
    return;

  local time_flying = StageObject_GetKeyValue(so_actor, "time_flying");
  time_flying += tdelta;
  StageObject_SetKeyValueFloat(so_actor, "time_flying", time_flying);

  local pos = StageObject_GetPosition(so_actor);
  pos[2] -= 10 * time_flying * tdelta;
  StageObject_SetPosition(so_actor, pos[0], pos[1], pos[2]);

  if (pos[2] < -2000)
  {
    if (UI_PeekScreen(0) == "Stage")
      UI_SwitchScreen("Credits");
  }
}

]]></node>
