    <node
      interaction_0_id="use"
        interaction_0_script_to_test_if_interaction_is_available="function IsInteractionAvailable(so_self, so_activator)&#10;{&#10;&#9;local num_investigated = Game_GetWorldStateAsInteger(&#34;OBELISKS&#34;, &#34;num_investigated&#34;, 0);&#10;&#9;local powered = StageObject_GetKeyValue(so_self, &#34;powered&#34;, false);&#10;&#10;&#9;if (abs(Game_GetAngleDifference(so_self, so_activator)) &#60; 130)&#10;&#9;{&#10;&#9;&#9;return false;&#10;&#9;}&#10;&#10;&#9;return num_investigated &#62;= 3 &#38;&#38; powered;&#10;}"
        interaction_0_script_to_run_on_interaction="function OnInteraction(so_self, so_activator)&#10;{&#10;&#9;//Game_AddActorNotification(so_self, &#34;DEVELOPER NOTE: COMING SOON!&#34;);&#10;&#9;//return;&#10;&#10;&#9;//Game_SaveGame();&#10;&#10;&#9;local id = &#34;puid&#34; + StageObject_GetPersistentUniqueId(so_self);&#10;&#9;local state = Game_GetWorldState(&#34;COMBAT_ALTARS&#34;, id);&#10;&#9;local level = state ? (state.tointeger() + 1) : 1;&#10;&#10;&#9;Game_LogEvent(&#34;OBELISK&#34;, &#34;START_&#34; + level.tostring(), StageObject_GetId(so_self));&#10;&#10;&#9;local blocking_path = StageObject_GetKeyValue(so_self, &#34;obelisk_fight_area&#34;);&#10;&#9;if (blocking_path != null)&#10;&#9;&#9;Game_AddBlockingPath(blocking_path);&#10;&#10;&#9;Actor_QueueActionMoveToBone(so_activator, so_self, &#34;snap&#34;);&#10;&#9;Actor_QueueActionPlayAnimation(so_activator, &#34;tool_unequip&#34;, true);&#10;&#9;Actor_QueueActionPlayAnimationWithTransition(so_activator, &#34;interaction_loop&#34;, &#34;interaction_once&#34;, true);&#10;&#10;&#9;local command = Command_Create(&#34;activate&#34;);&#10;&#9;Command_SetStageObjectReference(command, so_activator);&#10;&#9;Actor_QueueActionSendCommand(so_activator, so_self, command, 0);&#10;&#9;Command_Delete(command);&#10;&#10;&#9;local script = @&#34;Actor_PlayAnimation($so_self, &#34;&#34;used&#34;&#34;);&#34;;&#10;&#9;script = string_replace(script, &#34;$so_self&#34;, so_self.tostring());&#10;&#9;Actor_QueueActionRunScript(so_activator, script);&#10;&#10;&#9;Actor_QueueActionWaitForCommandWord(so_activator, &#34;wait&#34;);&#10;&#9;Actor_QueueActionStopAnimation(so_activator, &#34;interaction_loop&#34;, true);&#10;&#9;Actor_QueueActionPlayAnimation(so_activator, &#34;tool_equip&#34;, false);&#10;&#9;Actor_QueueActionSendCommandWord(so_activator, so_self, &#34;wait&#34;);&#10;}"
        interaction_0_trigger="PRESS_BUTTON"
        interaction_0_controller_button="USE"
        interaction_0_text="Use"
      interaction_1_id="reward"
        interaction_1_enabled="0"
        interaction_1_script_to_test_if_interaction_is_available="function IsInteractionAvailable(so_self, so_activator)&#10;{&#10;&#9;if (abs(Game_GetAngleDifference(so_self, so_activator)) &#60; 130)&#10;&#9;{&#10;&#9;&#9;return false;&#10;&#9;}&#10;&#10;&#9;return true;&#10;}"
        interaction_1_script_to_run_on_interaction="function OnInteraction(so_self, so_activator)&#10;{&#10;&#9;local id = &#34;puid&#34; + StageObject_GetPersistentUniqueId(so_self);&#10;&#9;local state = Game_GetWorldState(&#34;COMBAT_ALTARS&#34;, id);&#10;&#9;local level = state ? (state.tointeger() + 1) : 1;&#10;&#9;Game_LogEvent(&#34;OBELISK&#34;, &#34;WON_&#34; + level.tostring(), StageObject_GetId(so_self));&#10;&#9;if (level == 5)&#10;&#9;{&#10;&#9;&#9;Game_ChangeMedalProgressAmount(&#34;COMBAT_OBELISKS&#34;, 1);&#10;&#9;&#9;Game_SetStagePointOfInterestCompleted(so_self);&#10;&#10;&#9;&#9;local quest_id = &#34;quests/obelisk-intro.nut&#34;;&#10;&#9;&#9;Game_SendQuestPhaseCommandWord(quest_id, &#34;COMPLETE_DONE&#34;, &#34;activate&#34;);&#10;&#10;&#9;&#9;StageObject_SetKeyValueBoolean(so_self, &#34;completed&#34;, true);&#10;&#9;}&#10;&#10;&#9;Actor_QueueActionRunScript(so_activator, &#34;Game_SetCinemaMode(true);&#34;);&#10;&#9;Actor_QueueActionMoveToBone(so_activator, so_self, &#34;snap&#34;);&#10;&#9;Actor_QueueActionSendCommandWord(so_activator, so_self, &#34;wait&#34;);&#10;&#9;Actor_QueueActionWaitForCommandWord(so_activator, &#34;wait&#34;);&#10;&#9;Actor_QueueActionRunScript(so_activator, &#34;Game_SetCinemaMode(false);&#34;);&#10;&#10;&#9;Actor_QueueActionWaitForCommandWord(so_self, &#34;wait&#34;);&#10;&#9;Actor_QueueActionPlayAnimation(so_self, level + &#34;-completed&#34;, true);&#10;&#9;Actor_QueueActionSendCommandWord(so_self, so_activator, &#34;wait&#34;);&#10;&#10;&#9;Game_RemoveAllBlockingPaths();&#10;}"
