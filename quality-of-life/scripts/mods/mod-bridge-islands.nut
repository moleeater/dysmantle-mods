function Mod_BridgeIslands_OnGameStart_WaterPlane (waterplane, same) {
  if (Game_GetWorldStateAsInteger ("MODS", "bridge_islands_enabled", 0) == 1) {
    local stage = Stage_GetFilename();
    if (waterplane_puids.rawin(stage) == true) {
      local waterplane_puid = StageObject_GetPersistentUniqueId (waterplane);
      if (waterplane_puids[stage].rawin(waterplane_puid) == true) {
        foreach (bridge_data in waterplane_puids[stage][waterplane_puid]) {
          local bridge = Stage_CreateActor (bridge_data.actor_type, bridge_data.position[0], bridge_data.position[1], bridge_data.position[2], false);
          StageObject_AddTag (bridge, "MOD_BRIDGE_ISLANDS");
          StageObject_SetAngle (bridge, bridge_data.angle);
          Stage_SpawnEffect ("effects/fishing-spot-replenished.xml", bridge_data.position[0], bridge_data.position[1], bridge_data.position[2] + 60, bridge_data.angle + 90.0);
          Stage_SpawnEffect ("effects/drawbridge-impact-dust.xml", bridge_data.position[0], bridge_data.position[1], bridge_data.position[2], bridge_data.angle + 90.0);
          Stage_SpawnEffect ("effects/waterfall-splash-particles.xml", bridge_data.position[0], bridge_data.position[1], bridge_data.position[2] + 60, bridge_data.angle + 90.0);
        }
      }
    }
  }
}


function Mod_BridgeIslands_OnClick_OptionsUnified (clicked) {
  if (clicked != null) {
    switch (clicked) {
      case "mod_bridge_islands_enabled":
        local enabled = UI_GetProperty ("mod_bridge_islands_enabled", "checkbox.value") == 1 ? true : false;
        Game_SetWorldState ("MODS", "bridge_islands_enabled", enabled ? "1" : "0");
        if (enabled) {
          local stage = Stage_GetFilename();
          if (waterplane_puids.rawin(stage) == true) {
            foreach (waterplane_puid, chunk_bridges in waterplane_puids[stage]) {
              local waterplane = Stage_GetStageObjectByPUID (waterplane_puid);
              if (waterplane != null) {
                foreach (bridge_data in waterplane_puids[stage][waterplane_puid]) {
                  local bridge = Stage_CreateActor (bridge_data.actor_type, bridge_data.position[0], bridge_data.position[1], bridge_data.position[2], false);
                  StageObject_AddTag (bridge, "MOD_BRIDGE_ISLANDS");
                  StageObject_SetAngle (bridge, bridge_data.angle);
                }
              }
            }
          }
        } else {
          local bridges = Stage_QueryStageObjectsWithTag (STAGE_OBJECT_TYPE_ACTOR, "MOD_BRIDGE_ISLANDS");
          if (bridges != null && bridges.len() > 0) {
            foreach (bridge in bridges) {
              Stage_DeleteStageObjectQueued (bridge);
            }
          }
        }
        Game_LogEvent ("MOD_BRIDGE_ISLANDS", enabled ? "enabled" : "disabled");
        break;
      case "mod_bridge_islands_enabled_title":
        Mods_Info_Popup (
            LocalizeText("Bridge islands"),
            LocalizeText("Bridging previously inaccessible islands by a ropebridge or pier, if they have loot. Main game and DLCs covered."),
            [{"text": "|#ffffff||img src='ui/gfx/mods/mods-videos-youtube.png' scale=0.5 offset=1||#000000| demonstration",
              "OpenURL": LocalizeText("https://e934.short.gy/dysmantle-mod-bridge-islands-video")}] );
        break;
    }
  }
}


function Mod_BridgeIslands_OnEnter_OptionsUnified (stage_in_stack) {
  UI_SetProperty ("mod_bridge_islands_enabled", "checkbox.value", Game_GetWorldStateAsInteger ("MODS", "bridge_islands_enabled", 0));
  UI_SetProperty ("mod_bridge_islands_enabled_title", "textbox.text", LocalizeText("Bridge islands"));
}
