function Mods_by_MoleEater_OnTimeOfDay_ProtagonistReactions (player, hours, minutes) {
  if (this.rawin ("Mod_FlowerPower_OnTimeOfDay_ProtagonistReactions") == true) Mod_FlowerPower_OnTimeOfDay_ProtagonistReactions (player, hours, minutes);
  if (this.rawin ("Mod_Moonlight_OnTimeOfDay_ProtagonistReactions") == true) Mod_Moonlight_OnTimeOfDay_ProtagonistReactions (player, hours, minutes);
  if (this.rawin ("Mod_Yawning_OnTimeOfDay_ProtagonistReactions") == true) Mod_Yawning_OnTimeOfDay_ProtagonistReactions (player, hours, minutes);
}

function Mods_by_MoleEater_OnUpdate_ProtagonistReactions (player) {
  if (this.rawin ("Mod_AutoGasMask_OnUpdate_ProtagonistReactions") == true) Mod_AutoGasMask_OnUpdate_ProtagonistReactions (player);
  if (this.rawin ("Mod_BiggerBackpack_OnUpdate_ProtagonistReactions") == true) Mod_BiggerBackpack_OnUpdate_ProtagonistReactions (player);
}

function Mods_by_MoleEater_OnRespawnedAfterDeath_ProtagonistReactions (player, num_times_died) {
  if (this.rawin ("Mod_BulletTime_OnRespawnedAfterDeath_ProtagonistReactions") == true) Mod_BulletTime_OnRespawnedAfterDeath_ProtagonistReactions (player, num_times_died);
}

function Mods_by_MoleEater_OnDeath (player) {
  if (this.rawin ("Mod_LightSouls_OnDeath") == true) Mod_LightSouls_OnDeath (player);
}

function Mods_by_MoleEater_OnCoopPlayerJoined_ProtagonistReactions (primary_player, coop_player) {
  if (this.rawin ("Mod_Modifiers_Cheats_OnCoopPlayerJoined_ProtagonistReactions") == true) Mod_Modifiers_Cheats_OnCoopPlayerJoined_ProtagonistReactions (primary_player, coop_player);
  if (this.rawin ("Mod_Modifiers_QualityOfLife_OnCoopPlayerJoined_ProtagonistReactions") == true) Mod_Modifiers_QualityOfLife_OnCoopPlayerJoined_ProtagonistReactions (primary_player, coop_player);
}



