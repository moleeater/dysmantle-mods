function Mods_by_MoleEater_OnClick_NewGamePlus (clicked) {
  if (this.rawin ("Mod_Difficulty_OnClick_NewGamePlus") == true) Mod_Difficulty_OnClick_NewGamePlus (clicked);
  if (this.rawin ("Mod_NewGamePlusPlus_OnClick_NewGamePlus") == true) Mod_NewGamePlusPlus_OnClick_NewGamePlus (clicked);
}

function Mods_by_MoleEater_OnEnter_NewGamePlus() {
  if (this.rawin ("Mod_NewGamePlusPlus_OnEnter_NewGamePlus") == true) Mod_NewGamePlusPlus_OnEnter_NewGamePlus();
}



function Mods_by_MoleEater_OnSetupNewGame (test_game_start_id, player) {
  if (this.rawin ("Mod_Difficulty_OnSetupNewGame") == true) Mod_Difficulty_OnSetupNewGame (test_game_start_id, player);
  if (this.rawin ("Mod_NewGamePlusPlus_OnSetupNewGame") == true) Mod_NewGamePlusPlus_OnSetupNewGame (test_game_start_id, player);
}



function Mods_by_MoleEater_OnClick_FirstGameOptions (clicked) {
  if (this.rawin ("Mod_Difficulty_OnClick_FirstGameOptions") == true) Mod_Difficulty_OnClick_FirstGameOptions (clicked);
  if (this.rawin ("Mod_PreserveNature_OnClick_FirstGameOptions") == true) Mod_PreserveNature_OnClick_FirstGameOptions (clicked);
  if (this.rawin ("Mod_StartingStage_OnClick_FirstGameOptions") == true) Mod_StartingStage_OnClick_FirstGameOptions (clicked);
}

function Mods_by_MoleEater_OnEnter_FirstGameOptions() {
  if (this.rawin ("Mod_Difficulty_OnEnter_FirstGameOptions") == true) Mod_Difficulty_OnEnter_FirstGameOptions();
  if (this.rawin ("Mod_PreserveNature_OnEnter_FirstGameOptions") == true) Mod_PreserveNature_OnEnter_FirstGameOptions();
  if (this.rawin ("Mod_StartingStage_OnEnter_FirstGameOptions") == true) Mod_StartingStage_OnEnter_FirstGameOptions();
}



function Mods_by_MoleEater_OnEnter_MainMenu() {
