<?xml version="1.0" encoding="iso-8859-1"?>
<root>
  <array id="COMPONENTS">

    <node
     name="fader"
     type="SHADERFILTER"
     inherit="FaderBlurFilter"
     on_click_script_call="UI_PopScreen()"
     shaderfilter.cache_results="true"
     shaderfilter.rectangle_width="1158.41"
    />

<!-- MODS by MoleEater vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv -->
    <node
     name="panel"
     type="NINEPATCH"
     inherit="DecayNinePatchPanel"
     position.x="0.497656"
     position.y="0.5"
     scale="0.85"
     ui_scale_modifier="0.0"
     align="VCENTER,HCENTER"
     ninepatch.rectangle_width="780"
     ninepatch.automatic_content_height="true"
     ninepatch.automatic_content_padding="30"
    />
<!-- MODS by MoleEater ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ -->

    <node
     name="aligner_1"
     type="ALIGNER"
     inherit="EditorAligner"
     parent="panel"
     position.x="0.00261205"
     position.y="-0.48529"
     align="HCENTER"
     aligner.layout="STACK"
     aligner.automatic_area_height="true"
     aligner.min_padding="10"
    />

    <node
     name="marker_1"
     type="MARKER"
     inherit="DefaultMarker"
     parent="aligner_1"
     align="HCENTER"
     marker.area_width="100.389"
     marker.area_height="7.53439"
    />

    <node
     name="Title"
     type="TEXTBOX"
     inherit="LargeTextbox"
     parent="aligner_1"
     scale="0.749098"
     align="VCENTER,HCENTER"
     textbox.fit_inside_textbox="true"
     textbox.textbox_width="600"
     textbox.text="Language"
     textbox.text_align="VCENTER,HCENTER"
    />

    <node
     name="panel2"
     type="NINEPATCH"
     inherit="DecayNinePatchPanelInner"
     parent="aligner_1"
     align="VCENTER,HCENTER"
     ninepatch.rectangle_width="720"
     ninepatch.automatic_content_height="true"
     ninepatch.automatic_content_padding="20"
    />

    <node
     name="aligner_2"
     type="ALIGNER"
     inherit="EditorAligner"
     parent="panel"
     position.x="0.676742"
     position.y="0.00249066"
     scale="0.67573"
     aligner.area_height="169.651"
    />

    <node
     name="Back"
     type="BUTTON"
     inherit="SmallSquareButton"
     parent="marker_1"
     position.x="3.41808"
     position.y="4.40737"
     position.z="-0.0389345"
     localize="false"
     visible_for_control_interface="GROUP_POINTER_BASED"
     on_click_script_call="UI_PopScreen();"
     can_be_accessed_with_gamepads="false"
     scale="0.867017"
     button.text="X"
    />

    <node
     name="aligner_languages"
     type="ALIGNER"
     inherit="DefaultAligner"
     parent="panel2"
     position.x="0.000442542"
     position.y="0.000329523"
     aligner.area_width="680"
     aligner.automatic_area_height="true"
     aligner.fixed_num_columns="4"
     aligner.center_last_row_in_grid_layout="false"
    />

    <node
     name="ScanForLocalizations"
     type="BUTTON"
     inherit="DefaultButton"
     parent="aligner_2"
     localize="false"
     required_features="DEVELOPER_MODE"
     scale="0.857154"
     button.text="Scan for Localizations"
     button.ninepatch_width="402"
    />

    <node
     name="ScanAllLanguages"
     type="BUTTON"
     inherit="DefaultButton"
     parent="aligner_2"
     localize="false"
     required_features="DEVELOPER_MODE"
     scale="0.857154"
     button.text="Scan ALL Languages"
     button.ninepatch_width="402"
    />

    <node
     name="WriteTxtForProofreading"
     type="BUTTON"
     inherit="DefaultButton"
     parent="aligner_2"
     localize="false"
     required_features="DEVELOPER_MODE"
     scale="0.857154"
     button.text="Write Proofreading .txt"
     button.ninepatch_width="402"
    />

    <node
     name="Mods"
     type="BUTTON"
     inherit="DefaultButton"
     parent="aligner_1"
     localize="false"
     required_features="MODS"
     on_click_script_call="UI_PushScreen(\"Mods\");"
     scale="0.857154"
     button.text="Local Mods"
     button.ninepatch_width="402"
    />

    <node
     name="BrowseMods"
     type="BUTTON"
     inherit="DefaultButton"
     parent="aligner_1"
     visible="false"
     localize="false"
     required_features="MODS,STEAM"
     scale="0.857154"
     button.text="Steam Workshop"
     button.ninepatch_width="402"
    />

  </array>
</root>
