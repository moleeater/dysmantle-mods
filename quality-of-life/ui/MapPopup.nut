function Smooth(t)
{
  return t*t;
}


function OnUpdate(tdelta)
{
  UpdateUITransitionBasic("fader", "panel");
  UI_SetProperty("panel", "alpha", 1);//UI_GetScreenTransitionPhase());
  UI_SetProperty("panel", "position_offset.y", 1.0 * Smooth(1 - UI_GetScreenTransitionPhase()));
}


